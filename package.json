{
  "name": "ontoz-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:inquiry": "node scripts/build-inquiry-standalone.mjs",
    "build:wendy": "node scripts/build-wendy-standalone.mjs",
    "prepare:site": "node scripts/prepare-site.mjs",
    "dev": "npm run prepare:site && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run prepare:site && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "demo:lucas": "python3 -m http.server 8766 --bind 127.0.0.1",
    "test:backend": "python3 -B scripts/run-local-checks.py",
    "test:browser": "python3 -B scripts/run-local-checks.py --browser",
    "build:lucas": "python3 scripts/build-lucas-standalone.py",
    "build:lucas-animation": "python3 scripts/build-lucas-animation.py"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
